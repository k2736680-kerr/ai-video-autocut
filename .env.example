# 推荐做法：可以不创建 .env，直接使用系统环境变量 OPENAI_API_KEY。
# 如果你希望当前项目单独配置，也可以复制本文件为 .env。
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-5
TRANSCRIPTION_MODEL=whisper-1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
OUTPUT_FPS=30
# 快速测试时可临时设置为 360/640；正式导出留空或设为 0，按平台尺寸导出。
OUTPUT_WIDTH=0
OUTPUT_HEIGHT=0
TRANSCRIPTION_CHUNK_SECONDS=1200
OPENAI_TIMEOUT_SECONDS=120
SCENE_THRESHOLD=27.0
SCENE_MIN_LENGTH_FRAMES=15
